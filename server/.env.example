# --- Required secrets (copy to server/.env and fill in) ---

# Supabase Postgres — Project Settings → Database → Connection string (Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Google AI Studio key (embeddings) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq key (LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional tuning (defaults shown) ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
LLM_MODEL=openai/gpt-oss-120b
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.5
