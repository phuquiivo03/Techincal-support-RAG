{
  "name": "@rag/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:suite": "tsx scripts/eval-suite.ts",
    "test": "tsx --test src/modules/*/*.test.ts",
    "test:regression": "tsx scripts/regression.ts"
  },
  "dependencies": {
    "@rag/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "unpdf": "^0.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
